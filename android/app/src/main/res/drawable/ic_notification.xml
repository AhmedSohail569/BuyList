<?xml version="1.0" encoding="utf-8"?>
<!--
  Notification small icon for FCM.

  IMPORTANT (Android requirement):
  - Small icons are rendered as a SINGLE-COLOR glyph.
  - Only the alpha channel (shape) from the drawable is used.
  - The color comes from tint (here: @color/notification_color).

  To get a clean icon:
  - Make `notification_icon.png` a SOLID WHITE glyph on a TRANSPARENT background.
  - Avoid blue fills/strokes in the PNG itself — Android will tint it for you.
-->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:src="@drawable/notification_icon"
    android:tint="@color/notification_color"
    android:antialias="true" />
